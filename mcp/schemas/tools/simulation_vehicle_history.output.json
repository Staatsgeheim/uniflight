        },
        "page": {
          "$ref": "../common/common.schema.json#/$defs/PageInfo"
        }
      },
      "additionalProperties": false,
      "required": [
        "ok",
        "vehicle_id",
        "units",
        "items",
        "page"
      ]
    },
    {
      "$ref": "../common/common.schema.json#/$defs/ToolFailure"
    }
