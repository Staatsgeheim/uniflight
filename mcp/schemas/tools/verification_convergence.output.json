          "const": true
        },
        "verification_id": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "observed_orders": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "errors": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "report_artifact": {
          "$ref": "../common/common.schema.json#/$defs/ArtifactRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "ok",
        "verification_id",
        "passed",
        "observed_orders",
        "errors",
        "runs",
        "report_artifact"
      ]
    },
    {
      "$ref": "../common/common.schema.json#/$defs/ToolFailure"
    }
