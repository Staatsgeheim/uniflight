          }
        },
        "estimated_evaluations": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "ok",
        "valid",
        "errors",
        "estimated_evaluations"
      ]
    },
    {
      "$ref": "../common/common.schema.json#/$defs/ToolFailure"
    }
  ],
  "$id": "https://uniflight.dev/mcp/schemas/tools/optimization_validate.output.json"
}
